FROM rocker/r-ver:4.2.1

# System dependencies needed for compiling R packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    gfortran \
    make \
    cmake \
    git \
    curl \
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    libfontconfig1-dev \
    libfreetype6-dev \
    libpng-dev \
    libtiff5-dev \
    libjpeg-dev \
    libharfbuzz-dev \
    libfribidi-dev \
    libbz2-dev \
    liblzma-dev \
    libzstd-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Install remotes
RUN R -e "install.packages( \
    'remotes', \
    repos='https://cloud.r-project.org' \
)"

# -------------------------------------------------------------------
# Install pinned R packages.
# -------------------------------------------------------------------

RUN R -e "remotes::install_version( \
    'plyr', \
    version='1.8.9', \
    repos='https://cloud.r-project.org', \
    upgrade='never' \
)"

RUN R -e "remotes::install_version( \
    'dplyr', \
    version='1.1.4', \
    repos='https://cloud.r-project.org', \
    upgrade='never' \
)"

RUN R -e "remotes::install_version( \
    'tidyr', \
    version='1.3.1', \
    repos='https://cloud.r-project.org', \
    upgrade='never' \
)"

RUN R -e "remotes::install_version( \
    'readr', \
    version='2.1.5', \
    repos='https://cloud.r-project.org', \
    upgrade='never' \
)"

RUN R -e "remotes::install_version( \
    'ggplot2', \
    version='4.0.3', \
    repos='https://cloud.r-project.org', \
    upgrade='never' \
)"

RUN R -e "remotes::install_version( \
    'data.table', \
    version='1.17.2', \
    repos='https://cloud.r-project.org', \
    upgrade='never' \
)"

RUN R -e "remotes::install_version( \
    'valr', \
    version='0.8.2', \
    repos='https://cloud.r-project.org', \
    upgrade='never' \
)"

RUN R -e "remotes::install_version( \
    'stringr', \
    version='1.5.1', \
    repos='https://cloud.r-project.org', \
    upgrade='never' \
)"

RUN R -e "remotes::install_version( \
    'cowplot', \
    version='1.1.3', \
    repos='https://cloud.r-project.org', \
    upgrade='never' \
)"


# -------------------------------------------------------------------
# Print installed versions for easier Docker build debugging
# -------------------------------------------------------------------

RUN R -e " \
    pkgs <- c( \
        'plyr', \
        'dplyr', \
        'tidyr', \
        'readr', \
        'ggplot2', \
        'data.table', \
        'valr', \
        'stringr', \
        'cowplot' \
    ); \
    print(sapply(pkgs, function(x) as.character(packageVersion(x)))) \
"

# -------------------------------------------------------------------
# Verify exact versions.
# Build fails immediately if anything differs from what we expect.
# -------------------------------------------------------------------

RUN R -e "stopifnot( \
    as.character(packageVersion('plyr'))       == '1.8.9', \
    as.character(packageVersion('dplyr'))      == '1.1.4', \
    as.character(packageVersion('tidyr'))      == '1.3.1', \
    as.character(packageVersion('readr'))      == '2.1.5', \
    as.character(packageVersion('ggplot2'))    == '4.0.3', \
    as.character(packageVersion('data.table')) == '1.17.2', \
    as.character(packageVersion('valr'))       == '0.8.2', \
    as.character(packageVersion('stringr'))    == '1.5.1', \
    as.character(packageVersion('cowplot'))    == '1.1.3' \
)"

CMD ["R"]
