FROM rocker/r-ver:4.2.1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    libgit2-dev \
    libfontconfig1-dev \
    libfreetype6-dev \
    libpng-dev \
    libtiff5-dev \
    libjpeg-dev \
    libharfbuzz-dev \
    libfribidi-dev \
    libglpk-dev \
    libgmp3-dev \
    libicu-dev \
    zlib1g-dev \
    libbz2-dev \
    liblzma-dev \
    && rm -rf /var/lib/apt/lists/*

RUN R -e "install.packages('remotes', repos='https://cloud.r-project.org')"

RUN R -e "remotes::install_version('plyr', version='1.8.9', repos='https://cloud.r-project.org')"
RUN R -e "remotes::install_version('dplyr', version='1.1.4', repos='https://cloud.r-project.org')"
RUN R -e "remotes::install_version('tidyr', version='1.3.1', repos='https://cloud.r-project.org')"
RUN R -e "remotes::install_version('readr', version='2.1.5', repos='https://cloud.r-project.org')"
RUN R -e "remotes::install_version('ggplot2', version='4.0.3', repos='https://cloud.r-project.org')"
RUN R -e "remotes::install_version('data.table', version='1.17.2', repos='https://cloud.r-project.org')"
RUN R -e "remotes::install_version('valr', version='0.8.2', repos='https://cloud.r-project.org')"
RUN R -e "remotes::install_version('stringr', version='1.5.1', repos='https://cloud.r-project.org')"
RUN R -e "remotes::install_version('cowplot', version='1.1.3', repos='https://cloud.r-project.org')"

RUN R -e "stopifnot( \
    packageVersion('plyr') == '1.8.9', \
    packageVersion('dplyr') == '1.1.4', \
    packageVersion('tidyr') == '1.3.1', \
    packageVersion('readr') == '2.1.5', \
    packageVersion('ggplot2') == '4.0.3', \
    packageVersion('data.table') == '1.17.2', \
    packageVersion('valr') == '0.8.2', \
    packageVersion('stringr') == '1.5.1', \
    packageVersion('cowplot') == '1.1.3' \
)"

WORKDIR /work